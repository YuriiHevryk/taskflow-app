
{
  "servers": {
    "taskflow-vault": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/connector/server.py"
      ],
      "cwd": "${workspaceFolder}"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "repos",
        "X-MCP-Readonly": "true"
      }
    }
  }
}
